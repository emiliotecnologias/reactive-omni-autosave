# AutoSave Sentinel bot configuration — copy to .env and fill in.
# NEVER commit a real token. Dry-run mode needs none of these.

# Telegram Bot API token from @BotFather (placeholder only in this file)
TELEGRAM_BOT_TOKEN=123456:PLACEHOLDER_TOKEN_FROM_BOTFATHER
# Your chat id (message your bot, then check getUpdates)
TELEGRAM_CHAT_ID=000000000

# Destination chain (Base Sepolia) — where AutoSaveVault lives
DEST_RPC_URL=https://sepolia.base.org
VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Reactive chain (Lasna) — for reference / future CallbackRequest watching
REACTIVE_RPC_URL=https://lasna-rpc.rnk.dev/
REACTIVE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
